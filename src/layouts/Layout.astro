---
const title = Astro.props.title ?? "Ruhani Creations by Sumati";
const description = Astro.props.description ?? "Handcrafted fashion and curated designs by Ruhani Creations by Sumati";

const pathname = new URL(Astro.url).pathname;

// Clean pathname (remove trailing slashes, ensure it maps cleanly)
const cleanPath = pathname.replace(/\/$/, "");

const isHome = cleanPath === "" || cleanPath === "/index.html" || cleanPath === "/index";
const isCatalog = cleanPath.startsWith("/catalog");
const isAbout = cleanPath.startsWith("/about");
const isComingSoon = cleanPath.startsWith("/coming-soon");
const isHowToOrder = cleanPath.startsWith("/how-to-order");
const isContact = cleanPath.startsWith("/contact");
const isFaq = cleanPath.startsWith("/faq");
const isTerms = cleanPath.startsWith("/terms");
const isPrivacy = cleanPath.startsWith("/privacy");
const isResources = isContact || isFaq || isTerms || isPrivacy;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Great+Vibes&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <meta name="theme-color" content="#0f5e5f">
  <link rel="manifest" href="/site.webmanifest?v=20260319">
  <link rel="icon" href="/favicon.ico?v=20260319" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png?v=20260319">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png?v=20260319">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png?v=20260319">
</head>
<body class="layout">
  <header class="site-header">
    <div class="container header-shell">
      <a class="brand-lockup" href="/" aria-label="Ruhani Creations by Sumati home">
        <span class="brand-emblem-shell">
          <img class="brand-emblem" src="/assets/generated/rcbs-emblem-dark.png" alt="Ruhani Creations by Sumati emblem">
        </span>
        <span class="brand-wordmark" aria-label="Ruhani Creations by Sumati">
          <span class="brand-wordmark-main">
            <span class="brand-wordmark-name">Ruhani</span><span class="brand-wordmark-accent">Creations</span>
          </span>
          <span class="brand-wordmark-subline">
            <span class="brand-wordmark-line"></span><span class="brand-wordmark-sub">by Sumati</span><span class="brand-wordmark-line"></span>
          </span>
        </span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav-panel" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div id="site-nav-panel" class="site-nav-panel">
        <nav class="site-nav" aria-label="Primary navigation">
          <a class={`menu-link ${isHome ? "active" : ""}`} href="/">Home</a>
          <a class={`menu-link ${isCatalog ? "active" : ""}`} href="/catalog">Catalog</a>
          
          <div class={`nav-group ${isAbout ? "is-active" : ""}`}>
            <a class={`menu-link has-dropdown ${isAbout ? "active" : ""}`} href="/about">About Us</a>
            <div class="nav-dropdown">
              <a class={cleanPath === "/about#founder" ? "active" : ""} href="/about#founder">Founder</a>
              <a class={cleanPath === "/about#brand" ? "active" : ""} href="/about#brand">Brand</a>
            </div>
          </div>
          
          <a class={`menu-link ${isComingSoon ? "active" : ""}`} href="/coming-soon">Coming Soon</a>
          
          <div class={`nav-group ${isResources ? "is-active" : ""}`}>
            <span class={`menu-link has-dropdown ${isResources ? "active" : ""}`}>Resources</span>
            <div class="nav-dropdown">
              <a class={isContact ? "active" : ""} href="/contact">Contact</a>
              <a class={isFaq ? "active" : ""} href="/faq">FAQ</a>
              <a class={isTerms ? "active" : ""} href="/terms">Terms &amp; Conditions</a>
              <a class={isPrivacy ? "active" : ""} href="/privacy">Privacy Policy</a>
            </div>
          </div>
        </nav>
        <a class={`button secondary header-order-link ${isHowToOrder ? "active" : ""}`} href="/how-to-order">How to Order</a>
      </div>
    </div>
  </header>

  <div class="content-area">
    <slot />

    <footer class="site-footer">
      <div class="container footer-shell">
        <div class="footer-grid">
          <div class="footer-brand">
            <img class="footer-logo" src="/assets/RCBS_Logo_dark.PNG" alt="Ruhani Creations by Sumati dark logo">
            <p class="footer-copy">Ruhani Creations by Sumati is an Agra design studio for festive clothing, hand-painted details, curated bags, and keepsakes crafted with care.</p>
            <div class="footer-socials">
              <a href="https://wa.me/919105114152" target="_blank" rel="noreferrer">WhatsApp</a>
              <a href="https://www.instagram.com/ruhani.creations/" target="_blank" rel="noreferrer">Instagram</a>
              <a href="mailto:support@ruhanicreationsbysumati.com">Email</a>
            </div>
          </div>
          <div class="footer-column">
            <p class="footer-heading">Explore</p>
            <a href="/">Home</a>
            <a href="/catalog">Catalog</a>
            <a href="/coming-soon">Coming Soon</a>
            <a href="/how-to-order">How to Order</a>
          </div>
          <div class="footer-column">
            <p class="footer-heading">About Us</p>
            <a href="/about">Overview</a>
            <a href="/about#founder">Founder</a>
            <a href="/about#brand">Brand Story</a>
            <a href="/about#values">Design Values</a>
          </div>
          <div class="footer-column">
            <p class="footer-heading">Resources</p>
            <a href="/contact">Contact</a>
            <a href="/faq">FAQ</a>
            <a href="/terms">Terms &amp; Conditions</a>
            <a href="/privacy">Privacy Policy</a>
          </div>
          <div class="footer-column">
            <p class="footer-heading">Studio</p>
            <a href="https://www.google.com/maps/search/?api=1&amp;query=Ruhani%20Creations%20by%20Sumati%2C%20B27%2C%20Sarlabagh%20Extension%2C%20DayalBagh%2C%20Agra%2C%20Uttar%20Pradesh%20282005" target="_blank" rel="noreferrer">DayalBagh, Agra</a>
            <a href="tel:+919105114152">+91 91051 14152</a>
            <a href="mailto:support@ruhanicreationsbysumati.com">support@ruhanicreationsbysumati.com</a>
            <a href="mailto:order@ruhanicreationsbysumati.com">order@ruhanicreationsbysumati.com</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© <span class="js-year"></span> Ruhani Creations by Sumati. All rights reserved.</p>
          <div class="footer-bottom-links">
            <a href="/terms">Terms</a>
            <a href="/privacy">Privacy</a>
            <a href="/faq">FAQ</a>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <script is:inline src="/site.js"></script>
</body>
</html>