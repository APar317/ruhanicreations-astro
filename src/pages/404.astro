---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 Not Found | Ruhani Creations by Sumati"
  description="404 page for Ruhani Creations by Sumati."
>
  <main class="content-main status-page">

    <section class="status-box">

      <!-- STATUS CODE -->
      <p class="status-code">404</p>

      <!-- TITLE -->
      <h1>Page Not Found</h1>

      <!-- MESSAGE -->
      <p>The page you are trying to open does not exist, may have moved, or may not be published yet.</p>

      <!-- ACTIONS -->
      <div class="hero-actions">
        <a class="button primary" href="/">Back to Home</a>
        <a class="button ghost" href="/catalog">Open Catalog</a>
      </div>

    </section>

  </main>
</Layout>