---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Coming Soon | Ruhani Creations by Sumati"
  description="Upcoming design categories and handcrafted collections planned for Ruhani Creations by Sumati."
>
  <main class="content-main">
    <section class="page-hero">
      <div class="container page-hero-grid">
        <div>
          <p class="eyebrow">Coming Soon</p>
          <h1>New design categories are already being shaped behind the scenes.</h1>
          <p class="page-intro">Some items on the catalog are already marked as sold references, while these upcoming categories signal the next phase of the studio’s design line.</p>
        </div>
        <div class="brand-mark-card">
          <img class="page-mark" src="/assets/RCBS_Logo_dark.PNG" alt="Ruhani Creations by Sumati logo">
        </div>
      </div>
    </section>

    <div class="container page-stack">
      <section class="section-shell">
        <div class="section-head">
          <div>
            <p class="eyebrow">Upcoming Lines</p>
            <h2>Extensions of the same handcrafted language.</h2>
          </div>
        </div>
        <div class="collection-grid">
          <article class="placeholder-card">
            <span class="placeholder-tag">Coming Soon</span>
            <h3>Tote Bags with Zipper</h3>
            <p>Structured utility bags designed for gifting, daily carry, and studio-led detailing that still feels dressed up.</p>
          </article>
          <article class="placeholder-card">
            <span class="placeholder-tag">Coming Soon</span>
            <h3>Tote Bags without Zipper</h3>
            <p>Lightweight open totes for everyday use, casual gifting, and design stories that sit beyond occasion wear.</p>
          </article>
          <article class="placeholder-card">
            <span class="placeholder-tag">Coming Soon</span>
            <h3>Set of 3 Bags</h3>
            <p>Curated coordinated sets created for trousseau gifting, travel organization, and thoughtful keepsake packaging.</p>
          </article>
          <article class="placeholder-card">
            <span class="placeholder-tag">Coming Soon</span>
            <h3>Yoga Mat Carry Bag</h3>
            <p>Functional studio pieces that bring the brand’s design language into movement, routine, and mindful everyday use.</p>
          </article>
        </div>
      </section>
    </div>
  </main>
</Layout>